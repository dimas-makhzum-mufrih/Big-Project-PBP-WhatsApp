
/* =====================================================================
   BENTUK, HIASAN, GERAK
   Token:  [x]  = tema x, hiasan Penuh atau Ringan (Polos tidak kena)
           [@x] = tema x, hanya hiasan Penuh (ada gerak)
   Hanya CSS. Bubble tetap berlatar solid supaya teks terbaca.
   ===================================================================== */

/* hiasan duduk di bawah isi chat */
/* Hiasan (latar hidup, matahari, titik pastel) duduk di lapisan PALING BAWAH ruang: z-index -1 di dalam
   ruang yang terisolasi. Jadi semua isi (header, pesan, bilah sematan, tombol pin, lobi suara, panel) otomatis di depannya. */
html[data-gaya] .active-chat-room { isolation: isolate; }
html[data-gaya] .active-chat-header,
html[data-gaya] .pinned-message-container,
html[data-gaya] .messages-container,
html[data-gaya] .active-chat-footer { position: relative; z-index: 1; }

html[data-gaya] .active-chat-room::before,
html[data-gaya] .active-chat-room::after {
    content: none; position: absolute; z-index: -1; pointer-events: none;
}

/* ---------- Gameboy: LCD hijau, bubble piksel, 4 tingkat ---------- */
[gameboy] .active-chat-room::before {
    content: ""; inset: 0;
    background: radial-gradient(#306230 1px, transparent 1.4px) 0 0/6px 6px;
    opacity: .16;
}
[gameboy] .chat-bubble {
    border: 0; border-radius: 0; margin: 4px;
    box-shadow: 0 -4px 0 #0f380f, 0 4px 0 #0f380f, -4px 0 0 #0f380f, 4px 0 0 #0f380f;
}
[gameboy] .chat-bubble.kirim[data-tingkat="1"] { background: #b3cf3c; --teks-bubble: #0f380f; }
[gameboy] .chat-bubble.kirim[data-tingkat="2"] { background: #7fa012; --teks-bubble: #0f380f; }
[gameboy] .chat-bubble.kirim[data-tingkat="3"] { background: #306230; --teks-bubble: #9bbc0f; }
[gameboy] .chat-bubble.kirim[data-tingkat="4"] { background: #0f380f; --teks-bubble: #9bbc0f; }
[gameboy] .header-kiri h2, [gameboy] .tab, [gameboy] .card-title, [gameboy] .active-header-info h3,
[gameboy] .timestamp, [gameboy] .genre-chip {
    font-family: ui-monospace, "Courier New", monospace; letter-spacing: .04em; text-transform: uppercase;
}
[gameboy] .chat-card { border-bottom: 2px dashed #306230; border-radius: 0; }
[gameboy] .chat-card.aktif::before {
    content: "\25B6"; color: #0f380f; font-size: .8rem; margin-right: 8px;
}
[gameboy] .circle-avatar, [gameboy] .circle-avatar img { border-radius: 0; }
[gameboy] .chat-input-field, [gameboy] .search-bar-input { border-radius: 0; border: 2px solid #0f380f; }
[gameboy] .send-action-btn, [gameboy] .btn-mic { border-radius: 0; }

/* ---------- Terminal: monospace, awalan >, scanline ---------- */
[terminal] body, [terminal] button, [terminal] input { font-family: ui-monospace, "Cascadia Mono", "Courier New", monospace; }
[terminal] .chat-bubble {
    border: 1px solid #1fa84a; border-radius: 0; box-shadow: none; background: #031208;
}
[terminal] .chat-bubble.kirim { background: #06240f; }
[terminal] .chat-bubble > span:first-child::before { color: #1fa84a; margin-right: .5ch; }
[terminal] .chat-bubble.kirim > span:first-child::before { content: ">"; }
[terminal] .chat-bubble.terima > span:first-child::before { content: "<"; }
[terminal] .chat-card { border-bottom: 1px dashed #0f4a1f; border-radius: 0; }
[terminal] .chat-card .card-title::before { content: "$ "; color: #1fa84a; }
[terminal] .circle-avatar, [terminal] .circle-avatar img { border-radius: 0; }
[terminal] .chat-input-field { border-radius: 0; border: 1px solid #1fa84a; caret-color: #33ff66; caret-shape: block; }
[terminal] .search-bar-input { border-radius: 0; }
[terminal] .active-chat-room::after {
    content: ""; inset: 0; z-index: 2;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,.22) 0 1px, transparent 1px 3px);
}
html.efek-boot[data-theme="terminal"] body { animation: boot-terminal .9s steps(9) 1; }
@keyframes boot-terminal {
    0% { filter: brightness(3) blur(3px); opacity: 0; } 30% { opacity: 1; }
    60% { filter: brightness(1.8); } 100% { filter: none; }
}

/* ---------- Synthwave: matahari bergaris + grid perspektif ---------- */
[synthwave] .active-chat-room { background-image: linear-gradient(180deg, #140826 0%, #2a0f4a 55%, #5a1a6a 100%); }
[synthwave] .active-chat-room::before {
    content: ""; left: -30%; right: -30%; bottom: 0; height: 42%;
    background:
        linear-gradient(rgba(45,226,230,.6) 1px, transparent 1px) 0 0/100% 34px,
        linear-gradient(90deg, rgba(45,226,230,.6) 1px, transparent 1px) 0 0/48px 100%;
    transform: perspective(320px) rotateX(62deg); transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 95%);
    mask-image: linear-gradient(to top, #000 10%, transparent 95%);
    opacity: .5;
}
[@synthwave] .active-chat-room::before { animation: grid-maju calc(3.2s * var(--kec, 1)) linear infinite; }
@keyframes grid-maju { to { background-position: 0 34px, 48px 0; } }
[synthwave] .active-chat-room::after {
    content: ""; left: 50%; bottom: 20%; width: 150px; height: 150px; margin-left: -75px; border-radius: 50%;
    background: linear-gradient(180deg, #ffd23c 0%, #ff7a3c 45%, #ff3cac 100%);
    -webkit-mask-image: repeating-linear-gradient(180deg, #000 0 10px, transparent 10px 13px);
    mask-image: repeating-linear-gradient(180deg, #000 0 10px, transparent 10px 13px);
    opacity: .5;
}
[synthwave] .chat-bubble { border: 1.5px solid #2de2e6; }
[synthwave] .chat-bubble.kirim { border-color: #ff3cac; box-shadow: 0 0 14px rgba(255,60,172,.45); }
[synthwave] .chat-card.aktif { box-shadow: inset 3px 0 0 #ff3cac, 0 0 14px rgba(255,60,172,.25); }

/* ---------- Supernova: ledakan magenta-oranye, bubble berpendar ---------- */
[supernova] .active-chat-room::before {
    content: ""; inset: 0;
    background:
        radial-gradient(circle at 85% 8%, rgba(255,138,74,.38), transparent 45%),
        radial-gradient(circle at 10% 100%, rgba(255,79,168,.32), transparent 50%),
        linear-gradient(180deg, #0e040a, #1c0716);
}
[@supernova] .active-chat-room::before { animation: nova-denyut calc(7s * var(--kec, 1)) ease-in-out infinite alternate; }
@keyframes nova-denyut { from { filter: brightness(.85) saturate(1); } to { filter: brightness(1.25) saturate(1.3); } }
[supernova] .chat-bubble.kirim { box-shadow: 0 0 16px rgba(255,79,168,.55), inset 0 0 0 1px rgba(255,176,112,.5); }
[@supernova] .chat-bubble.kirim { animation: bubble-pendar calc(3.4s * var(--kec, 1)) ease-in-out infinite alternate; }
@keyframes bubble-pendar { to { box-shadow: 0 0 24px rgba(255,138,74,.7), inset 0 0 0 1px rgba(255,200,140,.7); } }

/* ---------- Nebula: awan + 3 lapis bintang (dibuat tema-efek.js), paralaks ---------- */
[nebula] .active-chat-room {
    background-image:
        radial-gradient(ellipse 50% 40% at 18% 15%, rgba(157,123,255,.26), transparent 70%),
        radial-gradient(ellipse 45% 40% at 85% 80%, rgba(80,140,255,.22), transparent 70%),
        linear-gradient(180deg, #08071a, #0f0c2e);
}
[nebula] .chat-bubble.kirim { box-shadow: 0 0 12px rgba(157,123,255,.35); }

.latar-hidup { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.latar-hidup canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.latar-hidup .lapis {
    position: absolute; inset: -70px;
    transform: translate(calc(var(--px, 0) * var(--f, 10) * 1px), calc(var(--py, 0) * var(--f, 10) * 1px - var(--sc, 0) * var(--f, 10) * .02px));
    will-change: transform;
}
.latar-hidup .lapis .awan { position: absolute; inset: 0; }
.latar-hidup .lapis .b { position: absolute; left: 0; top: 0; border-radius: 50%; animation: kelip calc(var(--t, 4s) * var(--kec, 1)) ease-in-out infinite alternate; }
@keyframes kelip { from { opacity: .25; } to { opacity: 1; } }

/* ---------- Supernova ---------- */
[supernova] .active-chat-room { background-image: linear-gradient(180deg, #0e040a, #1c0716); }
[supernova] .active-chat-room::before {
    content: ""; inset: 0;
    background:
        radial-gradient(circle at 85% 8%, rgba(255,138,74,.38), transparent 45%),
        radial-gradient(circle at 10% 100%, rgba(255,79,168,.32), transparent 50%);
}

/* ---------- Stardust ---------- */
[stardust] .active-chat-room { background-image: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(232,200,116,.10), transparent 70%), linear-gradient(180deg, #05050a, #0a0a12); }

/* ---------- Lavender Field: langit lilac, ladang lavender bergoyang, serbuk sari ---------- */
[lavender] .active-chat-room { background-image: linear-gradient(180deg, #efe6fb 0%, #e3d6f7 55%, #f4eefc 100%); }
[lavender] .chat-bubble { border-radius: 16px; }
[lavender] .chat-bubble.kirim::after {
    content: ""; position: absolute; right: 14px; bottom: -11px; width: 10px; height: 14px;
    background:
        radial-gradient(circle 2.6px at 50% 3px, #9b7fd6 98%, transparent),
        radial-gradient(circle 2.2px at 25% 7px, #b79cf0 98%, transparent),
        radial-gradient(circle 2.2px at 75% 7px, #b79cf0 98%, transparent),
        linear-gradient(#6fa86a, #6fa86a) 50% 9px/1.5px 5px no-repeat;
}
.latar-hidup[data-jenis="lavender"] svg { position: absolute; left: 0; bottom: 0; width: 100%; opacity: .92; }
.latar-hidup[data-jenis="lavender"] .goyang { animation: goyang calc(var(--t, 4s) * var(--kec, 1)) ease-in-out infinite alternate; animation-delay: var(--d, 0s); }
@keyframes goyang { from { transform: rotate(-2.6deg); } to { transform: rotate(2.6deg); } }
.latar-hidup .serbuk {
    position: absolute; left: var(--x); bottom: 6%; width: var(--s, 3px); height: var(--s, 3px); border-radius: 50%;
    background: #d9c6ff; box-shadow: 0 0 8px 2px rgba(190,160,255,.6); opacity: 0;
    animation: serbuk-naik calc(var(--t, 16s) * var(--kec, 1)) ease-in-out infinite; animation-delay: var(--d, 0s);
}
.latar-hidup .serbuk.kuning { background: #fff0a0; box-shadow: 0 0 8px 2px rgba(255,210,70,.7); }
@keyframes serbuk-naik {
    0% { transform: translate(0, 0); opacity: 0; } 15% { opacity: .9; }
    70% { opacity: .7; } 100% { transform: translate(var(--dx, 20px), -62vh); opacity: 0; }
}

/* ---------- Sunflower: matahari sederhana (bergerak sesuai jam) + bunga di dasar ---------- */
[sunflower] .active-chat-room { background-image: linear-gradient(180deg, #fff0b8 0%, #fff8e1 55%, #fdf1c2 100%); }
[sunflower] .active-chat-room::before {
    content: ""; width: 64px; height: 64px; border-radius: 50%;
    left: var(--mt-x, 82%); top: var(--mt-y, 14%); transform: translate(-50%, 0);
    background: radial-gradient(circle, #fff7d6 0 30%, #ffd23a 31% 100%);
    box-shadow: 0 0 46px 16px rgba(255,200,60,.55);
    transition: left 60s linear, top 60s linear;
}
.latar-hidup[data-jenis="sunflower"] svg { position: absolute; left: 0; bottom: 0; width: 100%; }
.latar-hidup[data-jenis="sunflower"] .goyang { animation: goyang-bunga calc(var(--t, 4s) * var(--kec, 1)) ease-in-out infinite alternate; animation-delay: var(--d, 0s); }
@keyframes goyang-bunga { from { transform: rotate(-1.8deg); } to { transform: rotate(1.8deg); } }
[sunflower] .chat-bubble { border-radius: 18px; }

/* ---------- Lotus Pond: bubble mengapung di atas kolam (kolam digambar tema-efek.js) ---------- */
[lotus] .active-chat-room { background-image: linear-gradient(180deg, #fde7ef 0%, #d6ecee 50%, #86cdbf 100%); }
[lotus] .chat-bubble {
    border-radius: 20px 20px 20px 6px; box-shadow: 0 12px 16px -10px rgba(20,110,100,.55), inset 0 0 0 1px rgba(255,255,255,.55);
}
[lotus] .chat-bubble.kirim { border-radius: 20px 20px 6px 20px; }
[lotus] .chat-bubble::after {
    content: ""; position: absolute; left: 8%; right: 8%; bottom: -11px; height: 12px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,.8); opacity: .65; transform: scaleY(.55); pointer-events: none;
}
[@lotus] .chat-bubble { animation: apung calc(5.5s * var(--kec, 1)) ease-in-out infinite; }
[@lotus] .message-row:nth-child(3n+2) .chat-bubble { animation-delay: -1.8s; }
[@lotus] .message-row:nth-child(3n) .chat-bubble { animation-delay: -3.6s; }
[@lotus] .chat-bubble::after { animation: cincin calc(3.5s * var(--kec, 1)) ease-out infinite; }
@keyframes apung { 50% { transform: translateY(-3px); } }
@keyframes cincin { from { transform: scale(.7, .4); opacity: .8; } to { transform: scale(1.18, .55); opacity: 0; } }

/* ---------- Rainy Window: kaca berembun, lampu kota blur, bisa diusap ---------- */
[rainy] .active-chat-room {
    background-image:
        radial-gradient(circle 70px at 18% 30%, rgba(255,190,90,.85), transparent 70%), radial-gradient(circle 90px at 72% 22%, rgba(90,200,255,.7), transparent 70%),
        radial-gradient(circle 60px at 44% 62%, rgba(255,90,170,.65), transparent 70%), radial-gradient(circle 80px at 86% 72%, rgba(255,230,140,.7), transparent 70%),
        radial-gradient(circle 55px at 8% 80%, rgba(120,255,200,.55), transparent 70%), linear-gradient(180deg, #0d1620, #14212e);
}
[rainy] .chat-bubble { border: 1px solid rgba(180,215,240,.28); }

.latar-hidup .kilat-hujan {
    position: absolute; inset: 0; opacity: 0;
    background: radial-gradient(ellipse 80% 70% at 62% 0%, rgba(215,228,255,.6), rgba(215,228,255,.12) 70%);
}
.latar-hidup .kilat-hujan.nyala { animation: petir .7s ease-out; }
@keyframes petir { 0% { opacity: 0; } 8% { opacity: 1; } 18% { opacity: .15; } 28% { opacity: .8; } 100% { opacity: 0; } }

/* ---------- Deep Ocean: gelembung naik, sinar menembus air, plankton bercahaya ---------- */
[ocean] .active-chat-room { background-image: linear-gradient(180deg, #0a6f86 0%, #04435a 40%, #021c28 100%); }
[ocean] .chat-bubble { border: 1px solid rgba(120,230,230,.25); }
.latar-hidup[data-jenis="laut"] .sinar {
    position: absolute; inset: -20% -10% 30% -10%;
    background: repeating-conic-gradient(from 190deg at 50% -10%, rgba(180,255,255,.13) 0 4deg, transparent 4deg 11deg);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 80%); mask-image: linear-gradient(to bottom, #000, transparent 80%);
    animation: sinar-goyang calc(14s * var(--kec, 1)) ease-in-out infinite alternate; transform-origin: 50% 0;
}
@keyframes sinar-goyang { from { transform: rotate(-4deg); } to { transform: rotate(4deg); } }
.latar-hidup .gel {
    position: absolute; bottom: -30px; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%;
    border: 1.5px solid rgba(190,255,255,.55); background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.35), transparent 60%);
    animation: gel-naik calc(var(--t) * var(--kec, 1)) linear infinite; animation-delay: var(--d);
}
@keyframes gel-naik { to { transform: translate(var(--dx, 0px), -115vh); opacity: .2; } }
.latar-hidup[data-jenis="laut"] .sinar { animation: sinar-goyang calc(14s * var(--kec, 1)) ease-in-out infinite alternate; transform-origin: 50% 0; }
@keyframes sinar-goyang { from { transform: rotate(-2.5deg); opacity: .8; } to { transform: rotate(2.5deg); opacity: 1; } }
.latar-hidup .plankton {
    position: absolute; left: var(--x); top: var(--y); width: var(--s, 3px); height: var(--s, 3px); border-radius: 50%;
    background: #aef5ff; box-shadow: 0 0 10px 3px rgba(110,230,255,.55); opacity: 0;
    animation: plankton-hanyut calc(var(--t, 10s) * var(--kec, 1)) ease-in-out infinite; animation-delay: var(--d, 0s);
}
@keyframes plankton-hanyut {
    0% { transform: translate(0, 0); opacity: 0; } 30% { opacity: .85; }
    70% { opacity: .5; } 100% { transform: translate(var(--dx, 30px), -34px); opacity: 0; }
}

/* ---------- Campfire: api unggun, bara terbang ---------- */
[campfire] .active-chat-room { background-image: linear-gradient(180deg, #0d0603 0%, #1c0d06 70%, #3a1706 100%); }
[campfire] .chat-bubble { border: 1px solid rgba(255,150,70,.22); }
[campfire] .chat-bubble.kirim { box-shadow: 0 0 14px rgba(255,120,40,.25); }
[campfire] .active-chat-room::before {
    content: ""; left: 10%; right: 10%; bottom: -8%; height: 38%;
    background: radial-gradient(ellipse 50% 70% at 50% 100%, rgba(255,140,40,.55), rgba(255,90,20,.18) 55%, transparent 75%);
}
[@campfire] .active-chat-room::before { animation: api-kedip calc(2.2s * var(--kec, 1)) ease-in-out infinite alternate; }
@keyframes api-kedip { from { opacity: .65; transform: scale(1, .94); } to { opacity: 1; transform: scale(1.05, 1.06); } }
.latar-hidup .bara {
    position: absolute; bottom: -10px; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%;
    background: radial-gradient(circle, #fff1b0, #ff8a2a 60%, transparent 70%); box-shadow: 0 0 6px 1px rgba(255,130,40,.7);
    animation: bara-naik calc(var(--t) * var(--kec, 1)) ease-out infinite; animation-delay: var(--d);
}
@keyframes bara-naik { to { transform: translate(var(--dx), -92vh) scale(.3); opacity: 0; } }

/* ---------- Golden Hour: langit berganti halus, matahari/bulan bergerak ---------- */
[goldenhour] .active-chat-room {
    background-image: linear-gradient(180deg, var(--gh-a) 0%, var(--gh-b) 62%, var(--gh-c) 100%);
}
[goldenhour] .welcome-screen { background-image: linear-gradient(180deg, var(--gh-a), var(--gh-b) 62%, var(--gh-c)); }
[goldenhour] .active-chat-room::before {
    content: ""; width: 56px; height: 56px; border-radius: 50%;
    left: var(--gh-x, 50%); top: var(--gh-y, 30%); transform: translate(-50%, 0);
    background: radial-gradient(circle, #fff7d6 0 30%, var(--gh-sun, #ffd27a) 31% 100%);
    box-shadow: 0 0 44px 14px var(--gh-sun, #ffd27a); opacity: .85;
    transition: left 60s linear, top 60s linear;
}
[goldenhour][data-benda="bulan"] .active-chat-room::before {
    background: radial-gradient(circle at 36% 38%, #ffffff 0 30%, #dfe6ff 31% 100%);
    box-shadow: 0 0 36px 8px rgba(223,230,255,.45);
}
[goldenhour] .chat-bubble { box-shadow: 0 2px 10px rgba(0,0,0,.18); }

/* ---------- Pastel Party: pop, stiker, tepi tebal ungu tua ---------- */
[pastelparty] { --tinta: #4a3a63; }
html[data-theme="pastelparty"] { font-family: ui-rounded, "Nunito", "Varela Round", "Segoe UI", system-ui, sans-serif; }
[pastelparty] .active-chat-room::after {
    content: ""; inset: 0; z-index: -1;
    background:
        radial-gradient(circle 5px at 8% 14%, #ffc4da 98%, transparent), radial-gradient(circle 4px at 22% 86%, #bfe1ff 98%, transparent),
        radial-gradient(circle 6px at 92% 22%, #dccbff 98%, transparent), radial-gradient(circle 4px at 80% 90%, #c2efdc 98%, transparent),
        radial-gradient(circle 3px at 50% 6%, #ffe48a 98%, transparent), radial-gradient(circle 5px at 4% 56%, #ffe48a 98%, transparent);
    opacity: .9;
}
[pastelparty] .chat-bubble {
    border: 2.5px solid var(--tinta) !important; border-radius: 20px; padding: 9px 14px 6px;
    box-shadow: 3px 3px 0 var(--tinta) !important;
}
[pastelparty] .chat-bubble.kirim { border-bottom-right-radius: 4px; }
[pastelparty] .chat-bubble.terima { border-bottom-left-radius: 4px; background: #fff; }
[pastelparty] .chat-bubble.kirim[data-tingkat="1"] { background: #ffc4da; }
[pastelparty] .chat-bubble.kirim[data-tingkat="2"] { background: #bfe1ff; }
[pastelparty] .chat-bubble.kirim[data-tingkat="3"] { background: #dccbff; }
[pastelparty] .chat-bubble.kirim[data-tingkat="4"] { background: #c2efdc; }
[@pastelparty] .message-row:last-child .chat-bubble { animation: pop-masuk .42s cubic-bezier(.3, 1.7, .5, 1); }
@keyframes pop-masuk { from { transform: scale(.5) rotate(-4deg); opacity: 0; } }
[pastelparty] .chat-card {
    --pp: #ffc4da; width: calc(100% - 20px); margin: 10px 10px 4px; padding: 10px 14px;
    border: 2.5px solid var(--tinta); border-radius: 18px; background: var(--pp) !important;
    box-shadow: 3px 3px 0 var(--tinta); transition: transform .18s cubic-bezier(.3, 1.6, .5, 1), box-shadow .18s;
}
[pastelparty] .chat-card:nth-child(4n+2) { --pp: #bfe1ff; }
[pastelparty] .chat-card:nth-child(4n+3) { --pp: #dccbff; }
[pastelparty] .chat-card:nth-child(4n+4) { --pp: #c2efdc; }
[pastelparty] .chat-card:hover { transform: translate(-1px, -2px) rotate(-.5deg); box-shadow: 5px 5px 0 var(--tinta); }
[pastelparty] .chat-card.aktif { transform: translate(3px, 3px); box-shadow: 0 0 0 var(--tinta); }
[pastelparty] .chat-card .card-title, [pastelparty] .chat-card .card-preview, [pastelparty] .chat-card small { color: var(--tinta) !important; }
[pastelparty] .circle-avatar { border: 2.5px solid var(--tinta); }
[pastelparty] .header-kiri, [pastelparty] .active-chat-header {
    background: #ffe3ef; border-bottom: 3px solid var(--tinta);
}
[pastelparty] .active-chat-footer { background: #e6f2ff; border-top: 3px solid var(--tinta); }
[pastelparty] .tab.aktif { border-image: none; border-color: var(--tinta); }
[pastelparty] .chat-input-field, [pastelparty] .search-bar-input {
    border: 2.5px solid var(--tinta); border-radius: 999px; background: #fff; box-shadow: 2px 2px 0 var(--tinta);
}
[pastelparty] .send-action-btn, [pastelparty] .btn-mic { border: 2.5px solid var(--tinta); border-radius: 999px; box-shadow: 2px 2px 0 var(--tinta); color: var(--tinta); }

/* ---------- Efek kirim pesan (dipicu tema-efek.js) ---------- */
.efek-kirim { position: absolute; inset: 65px 0 65px 0; z-index: 3; overflow: hidden; pointer-events: none; }
html:not([data-hiasan="penuh"]) .efek-kirim { display: none; }

.efek-kirim .bintang {
    position: absolute; left: var(--x, 70%); top: var(--y, 6%); width: var(--len, 120px); height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, #fff 0%, rgba(255,255,255,.7) 12%, rgba(255,255,255,0) 100%);
    transform-origin: 0 50%; opacity: 0;
    animation: bintang-jatuh var(--dur, .9s) ease-in forwards; animation-delay: var(--d, 0s);
}
.efek-kirim .bintang::before {
    content: ""; position: absolute; left: -2px; top: -2px; width: 6px; height: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 8px 3px rgba(255,255,255,.75);
}
@keyframes bintang-jatuh {
    0% { transform: translate(0, 0) rotate(-32deg); opacity: 0; }
    12% { opacity: 1; }
    100% { transform: translate(-420px, 262px) rotate(-32deg); opacity: 0; }
}

.efek-kirim .riak {
    position: absolute; right: 8%; bottom: 8%; width: 40px; height: 40px; margin: 0 0 0 0; border: 2px solid #f08fb0; border-radius: 50%;
    opacity: 0; animation: riak-lebar 1.3s ease-out forwards; animation-delay: var(--d, 0s);
}
@keyframes riak-lebar { from { transform: scale(.2); opacity: .9; } to { transform: scale(5.5); opacity: 0; } }

.efek-kirim .kelopak {
    position: absolute; top: -20px; left: var(--x); width: 11px; height: 8px; border-radius: 80% 0 80% 0;
    background: var(--warna-kelopak, #ffb8d0); opacity: .9;
    animation: kelopak-jatuh 2.4s ease-in forwards; animation-delay: var(--d, 0s);
}
@keyframes kelopak-jatuh { to { transform: translate(var(--dx), 120vh) rotate(var(--r)); opacity: 0; } }
html[data-theme="lavender"] .efek-kirim .kelopak { --warna-kelopak: #b79cf0; }

.efek-kirim .kilat { position: absolute; inset: 0; background: rgba(51,255,102,.16); animation: kilat-hijau .35s steps(3) forwards; }
@keyframes kilat-hijau { 50% { opacity: .5; } to { opacity: 0; } }

.efek-kirim .konfeti {
    position: absolute; right: 9%; bottom: 9%; width: 9px; height: 9px; border-radius: 2px;
    background: #ffc4da; border: 1.5px solid #4a3a63; animation: konfeti-lompat 1.1s cubic-bezier(.2, .8, .3, 1) forwards;
}
.efek-kirim .konfeti:nth-child(4n+1) { background: #ffc4da; }
.efek-kirim .konfeti:nth-child(4n+2) { background: #bfe1ff; border-radius: 50%; }
.efek-kirim .konfeti:nth-child(4n+3) { background: #dccbff; }
.efek-kirim .konfeti:nth-child(4n+4) { background: #ffe48a; border-radius: 50%; }
@keyframes konfeti-lompat { to { transform: translate(var(--dx), var(--dy)) rotate(var(--r)); opacity: 0; } }

.efek-kirim .gel-efek {
    position: absolute; right: 9%; bottom: 9%; width: var(--s); height: var(--s); border-radius: 50%;
    border: 1.5px solid rgba(190,255,255,.8); background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.4), transparent 60%);
    animation: gel-efek 1.6s ease-out forwards; animation-delay: var(--d, 0s);
}
@keyframes gel-efek { to { transform: translate(var(--dx), -260px); opacity: 0; } }
.efek-kirim .percik {
    position: absolute; right: 9%; bottom: 9%; width: 4px; height: 4px; border-radius: 50%;
    background: #ffb040; box-shadow: 0 0 8px 2px rgba(255,140,40,.85); animation: percik-loncat 1.1s cubic-bezier(.2, .8, .3, 1) forwards;
}
@keyframes percik-loncat { to { transform: translate(var(--dx), var(--dy)); opacity: 0; } }

html[data-efek="mati"] .efek-kirim { display: none; }

/* ---------- Tingkat hiasan "Ringan": semua gerak mati ---------- */
html[data-hiasan="ringan"] .active-chat-room,
html[data-hiasan="ringan"] .active-chat-room::before,
html[data-hiasan="ringan"] .active-chat-room::after,
html[data-hiasan="ringan"] .chat-bubble,
html[data-hiasan="ringan"] .latar-hidup *,
html[data-hiasan="ringan"] .active-chat-room::before,
html[data-hiasan="ringan"] .chat-bubble::after { animation: none !important; }

@media (prefers-reduced-motion: reduce) {
    .active-chat-room, .active-chat-room::before, .active-chat-room::after, .chat-bubble, .efek-kirim * { animation: none !important; transition: none !important; }
    .efek-kirim { display: none; }
}
